# Copy to .env and fill with real values.
# NEVER commit .env — this is a public repository!
# Get these from https://api.slack.com/apps → your app →:

# Settings → Socket Mode → "Generate an App-Level Token" (scope: connections:write)
SLACK_APP_TOKEN=

# OAuth & Permissions → "Install to Workspace" → Bot User OAuth Token
SLACK_BOT_TOKEN=

# Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=
